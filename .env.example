# Copy to .env and fill in. Never commit .env. Values below are placeholders/defaults.

# ---------------------------------------------------------------------------------------------- server
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
# Required. Dashboard/API admin token (>= 24 chars). Generate: openssl rand -hex 32
ADMIN_API_TOKEN=REPLACE-WITH-A-LONG-RANDOM-TOKEN
# PostgreSQL. Embedded PGlite by default (no server needed); use a postgres:// URL for a Postgres container or
# Supabase (the same migrations run on all three).
DATABASE_URL=pglite:./data/pg
# Docker Compose only: password for the bundled Postgres service.
POSTGRES_PASSWORD=REPLACE-WITH-A-DATABASE-PASSWORD
LOG_LEVEL=info
LOG_DIR=./logs

# ---------------------------------------------------------------------------------------------- chain
CHAIN_ID=56
# Comma-separated, used with automatic fallback. RPC_URL (single) is tried first when set.
RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io
# RPC_URL=
CONTRACT_ADDRESS=0x18B2A687610328590Bc8F2e5fEdDe3b582A49cdA
# Blocks to wait before treating a round as final (BSC has fast finality; 3 is conservative).
CONFIRMATIONS=3
POLL_INTERVAL_MS=3000

# ---------------------------------------------------------------------------------------------- pool events (research)
# eth_getLogs endpoint(s) for per-bet pool events. BNB Chain's dataseeds reject eth_getLogs; 48.club serves logs
# with block timestamps but prunes history after a few days, so keep the collector running continuously.
LOG_RPC_URLS=https://rpc-bsc.48.club
POOL_EVENTS_ENABLED=true
POOL_EVENTS_CHUNK_BLOCKS=5000
# How far below the first collected block to backfill (600000 blocks is about 3 days at 0.45 s). 0 disables.
POOL_EVENTS_BACKFILL_BLOCKS=600000

# ---------------------------------------------------------------------------------------------- wallet
# Only needed for live trading. Use a dedicated hot wallet holding only what you are prepared to lose.
# The key is read from the environment only: never stored in the database, never logged, never sent to the UI.
PRIVATE_KEY=
# Optional watch-only address (or a consistency check against PRIVATE_KEY).
WALLET_ADDRESS=

# ---------------------------------------------------------------------------------------------- modes
# Live trading is OFF unless this is true AND it is armed in the dashboard AND the strategy enables it.
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
PAPER_STARTING_BANKROLL=1
# After a restart live trading stays disarmed unless this is true.
BOT_AUTO_RESUME_LIVE=false

# ---------------------------------------------------------------------------------------------- global risk limits (BNB)
# Hard ceilings. Strategy-level limits can only tighten them.
DEFAULT_BET_SIZE=0.001
MAX_BET_SIZE=0.01
# Every stake is raised to at least this (still subject to every other cap). 0 disables.
MIN_BET_SIZE=0
# Stakes above ESCALATION_STAKE_THRESHOLD are only allowed once the strategy has ESCALATION_MIN_LOSS_STREAK
# consecutive losses; until then they are clamped to the threshold. 0 disables. Keep MAX_CONSECUTIVE_LOSSES
# above the streak, or its cooldown starts exactly when the escalated stake unlocks.
ESCALATION_STAKE_THRESHOLD=0
ESCALATION_MIN_LOSS_STREAK=0
MAX_BANKROLL_FRACTION=0.05
MAX_DAILY_LOSS=0.05
MAX_CONSECUTIVE_LOSSES=5
COOLDOWN_ROUNDS=12
MAX_TOTAL_EXPOSURE=0.05
MIN_WALLET_BALANCE=0.01
MAX_GAS_PRICE_GWEI=5
MIN_SECONDS_BEFORE_LOCK=6
MAX_EXECUTION_FAILURES=3
# Live bets need a positive expected value after fee, own-stake dilution, gas and late money (paper is unaffected).
LIVE_REQUIRE_POSITIVE_EV=true
# How far late money is expected to pull the pool split toward 50/50 by lock (0..1). Calibrate with the research
# `pool` family (perOffset[].balancePull in the experiment result); 0.5 is a conservative prior.
EDGE_BALANCE_PULL=0.5
# Check every paper fill against the live pre-flight and a simulated contract call (never broadcast), so paper
# results show how many bets would really have been accepted live.
SHADOW_PREFLIGHT=true

# ---------------------------------------------------------------------------------------------- claims & simulation
CLAIM_BATCH_MIN=3
CLAIM_MAX_DELAY_MINUTES=60
SIMULATED_GAS_PER_BET=0.00001
SIMULATED_GAS_PER_CLAIM=0.00001

# ---------------------------------------------------------------------------------------------- sync
SYNC_BATCH_SIZE=200
SYNC_CONCURRENCY=2
WALLET_SYNC_INTERVAL_MS=60000
RECONCILE_INTERVAL_MS=600000
