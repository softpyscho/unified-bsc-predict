# Installed by deploy/linux/setup.sh (placeholders are filled in there).
[Unit]
Description=BSC Predict worker (paper trading, data collection, research)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ --disable-warning=ExperimentalWarning apps/server/dist/main.js
# Restart after any exit, 10 s later; a clean stop (SIGTERM) releases the worker lease first.
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
